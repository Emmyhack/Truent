# Database
DATABASE_URL="postgresql://user:password@localhost:5432/truent_web"
TRUENT_BINARY="/usr/local/bin/truent"
SCAN_WORKER_POLL_MS="1000"
SCAN_MAX_ATTEMPTS="3"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-string-with-openssl-rand-base64-32"

# Civic Auth (https://auth.civic.com) — Google, email, passkeys and embedded
# wallets through one provider. The client id is public; leave it empty to hide
# the Civic button and keep only email/password and Web3 wallet sign-in.
# Register http://localhost:3000/api/civic/callback as the redirect URL.
NEXT_PUBLIC_CIVIC_CLIENT_ID=""

# Stripe Payment Gateway
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Crypto Payment Gateway (Thirdweb or similar)
NEXT_PUBLIC_THIRDWEB_CLIENT_ID="your-thirdweb-client-id"

# Crypto payment verification (required for /api/payment/crypto to approve any payment)
ETHEREUM_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/your-api-key"
PAYMENT_RECEIVER_ADDRESS="0xYourTreasuryWalletAddress"
