# Database
DATABASE_URL="postgresql://user:password@localhost:5432/truent_web"
TRUENT_BINARY="/usr/local/bin/truent"
SCAN_WORKER_POLL_MS="1000"
SCAN_MAX_ATTEMPTS="3"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-string-with-openssl-rand-base64-32"

# Civic Auth (https://auth.civic.com) — Google, email, passkeys and embedded
# wallets through one provider. The client id is public; leave it empty to hide
# the Civic button and keep only email/password and Web3 wallet sign-in.
# Register http://localhost:3000/api/civic/callback as the redirect URL.
NEXT_PUBLIC_CIVIC_CLIENT_ID=""

# Stripe Payment Gateway
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Crypto payment verification (required for /api/payment/crypto to approve any payment).
# No payment-gateway account is needed: any Ethereum JSON-RPC endpoint works, including
# free public ones that need no sign-up, e.g. https://ethereum-rpc.publicnode.com.
# An Alchemy or Infura key (personal email is fine) is steadier under load.
# Leave ETHEREUM_RPC_URL empty to keep the crypto path disabled; it fails closed.
ETHEREUM_RPC_URL="https://ethereum-rpc.publicnode.com"
PAYMENT_RECEIVER_ADDRESS="0xeF7e2fEf1373D3C81829B38adc026546fe39b960"
