# Copy to `.env` at the repository root (never commit it): cp deploy/env.example .env

# Required
POSTGRES_PASSWORD=change-me-to-a-long-random-string
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Where the site is reached. Local: http://localhost:3080. Tunnel or host: its https URL.
NEXTAUTH_URL=http://localhost:3080

# Host ports (change only if something else already listens there)
WEB_PORT=3080
DB_PORT=5433

# Civic Auth (public client id; empty hides the Civic button).
# Register <NEXTAUTH_URL>/api/civic/callback as the redirect URL.
NEXT_PUBLIC_CIVIC_CLIENT_ID=

# Stripe — test-mode keys are free. Webhook: <NEXTAUTH_URL>/api/payment/webhook
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Crypto payment verification (leave empty to keep that path disabled; it fails closed).
# Any Ethereum JSON-RPC URL works; https://ethereum-rpc.publicnode.com needs no account.
ETHEREUM_RPC_URL=
PAYMENT_RECEIVER_ADDRESS=

# Worker
WORKER_REPLICAS=1
SCAN_WORKER_POLL_MS=1000
SCAN_MAX_ATTEMPTS=3
